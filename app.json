{
  "expo": {
    "name": "Zy-Run",
    "slug": "zy-run",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Zy-Run_Official.png",
    "scheme": "com.zyapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/Zy-Run_Official.png"
    },
    "android": {
      "icon": "./assets/images/zyrun-adaptive-foreground.png",
      "adaptiveIcon": {
        "backgroundColor": "#090B0A",
        "foregroundImage": "./assets/images/zyrun-adaptive-foreground.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "POST_PROMOTED_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.zyapp",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/Zy-Run_Official.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "zyrun-business-notifications",
          "icon": "./assets/images/notification-icon.png",
          "color": "#22C55E"
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidMotionActivityEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Allow this app to access your location even when the app is in the background to track your run.",
          "locationWhenInUsePermission": "Allow this app to use your location while you are running.",
          "motionUsagePermission": "Allow this app to detect whether you are walking or running while recording a workout."
        }
      ],
       [
    "react-native-maps",
    {
      "androidGoogleMapsApiKey": "AIzaSyCbfFEhN28i6_DmvgUdRN6FUH9UVaTJoAk"
    }
  ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090B0A",
          "image": "./assets/Zy-Run_Official.png",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-image",
      "expo-image-picker",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleAndroidClientId": "1012302664400-ncmdep47qdvvh7eg8vrge88ak0qbcr79.apps.googleusercontent.com",
      "googleWebClientId": "1012302664400-ncmdep47qdvvh7eg8vrge88ak0qbcr79.apps.googleusercontent.com",
      "apiUrl": "https://zyrun.in/",
      "googleMapsApiKey": "AIzaSyCbfFEhN28i6_DmvgUdRN6FUH9UVaTJoAk"
    }
  }
}
